[user]
	name = YukihiroKimuraJ
	email = 229702967+YukihiroKimuraJ@users.noreply.github.com
	useConfigOnly = true

# Machine-private values, including addresses that must never be committed.
[include]
	path = ~/.gitconfig-private

# Repositories cloned under ~/oss/ use a reachable public address when a
# project's contribution policy requires one.
# gitdir/i (case-insensitive) because APFS is case-insensitive by default:
# a clone made in ~/OSS/ would not match "gitdir:" and would silently fall
# back to the noreply identity above.
[includeIf "gitdir/i:~/oss/"]
	path = ~/.gitconfig-oss
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	pager = delta
	hooksPath = ~/dotfiles/home/.git-hooks
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
[alias]
	whoami = var GIT_AUTHOR_IDENT
