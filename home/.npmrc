# Global npm / pnpm config.
#
# Fetch public packages through Takumi Guard (GMO Flatt Security), which blocks
# known-malicious packages before the tarball is downloaded. Anonymous use, so
# no token is needed.
#
# Scope: npm and pnpm both read ~/.npmrc, so this covers every project that
# does not override `registry` in its own .npmrc.
#
# Verify it is actually in effect (official canary, expects 403):
#   npm install @panda-guard/test-malicious
#   -> 403 Forbidden ... Package blocked by security policy
#
# Blocking happens on the metadata request, so `resolved` URLs in a lockfile
# still point at registry.npmjs.org. That is expected: a blocked package never
# reaches the tarball step.
#
# Known limits:
#   - Read-only proxy. `npm login` / `npm publish` / `npm adduser` are not
#     supported. Override per command:
#     npm publish --registry=https://registry.npmjs.org/
#   - Packages routed to another registry (private scopes) bypass the scan.
#   - If npm.flatt.tech is unreachable, installs fail. Temporary bypass:
#     npm install --registry=https://registry.npmjs.org/
#
# WARNING: this file is version-controlled in a PUBLIC repository. Never write
# an auth token here (`//registry.../:_authToken=...`). Put credentials in
# ~/.npmrc.local or an environment variable instead.
registry=https://npm.flatt.tech/

# Cooldown: refuse versions published less than 7 days ago.
#
# Takumi Guard blocks packages already known to be malicious; this blocks the
# window before anyone knows. Compromised releases are typically pulled within
# hours (axios: ~3h, s1ngularity: ~4h), but keyv@6.0.0 went unnoticed longer, so
# a multi-day cooldown is what actually covers that class of attack.
#
# Requires npm >= 11.10.0. Unit is DAYS here.
#
# This key is npm-only. pnpm ignores it and reads its own `minimumReleaseAge`,
# in MINUTES, from ~/Library/Preferences/pnpm/config.yaml on macOS (NOT
# ~/.config/pnpm/config.yaml -- that path only applies when XDG_CONFIG_HOME is
# set; check with `pnpm config get globalconfig`). Keep the two in sync.
#
# To take an urgent patch before the window elapses, exempt it explicitly:
#   min-release-age-exclude=some-package
#   npm install some-package --min-release-age=0
min-release-age=7
